# Padrão: somente localhost. Para VPN, use o IP Tailscale privado do host.
INSTAZAP_BIND=127.0.0.1
INSTAZAP_PORT=8765
INSTAZAP_DATA=./data
# Opcional na rede privada; OBRIGATÓRIO se publicar na internet.
# Gere com: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
INSTAZAP_ACCESS_SECRET=
# 0 permite cookie em HTTP privado/Tailscale; em HTTPS público, usar 1.
INSTAZAP_SECURE_COOKIE=0
# Origem exata (sem / final), obrigatória atrás de proxy HTTPS público.
INSTAZAP_ORIGIN=
